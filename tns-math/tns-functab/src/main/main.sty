% == FUNCTABLE ENV. - MAIN API == %

% -- \L3 INTERFACE -- %

\ExplSyntaxOn

\msg_set:nnnn { tns-functab ~ (main) }
  { main : context-unknown  }
  {
    illegal ~ context ~ << ~ #2 ~ >> ~.
    ~
    See ~ the ~ context ~ nb.#1.
  }
  { \msg_see_documentation_text:n { tns-functab } }


\msg_set:nnnn { tns-functab ~ (main) }
  { main : context-misplaced }
  {
    the ~ context ~ << ~ #1 ~ >> ~ must ~ be ~
    at ~ the ~ #2 ~ place.
  }
  { \msg_see_documentation_text:n { tns-functab } }


\msg_set:nnnn { tns-functab ~ (main) }
  { main : context-bad-use }
  {
    bad ~ use ~ of ~ the ~ context ~ << ~ #2 ~ >> ~.
    ~
    See ~ the ~ context ~ nb.#1.
  }
  { \msg_see_documentation_text:n { tns-functab } }


% Shortnames of contexts.
\prop_clear_new:N        \c_tns_functab_shortname_ctxts_prop
\prop_set_from_keyval:Nn \c_tns_functab_shortname_ctxts_prop {
  i = imgs,
  m = mat,
  s = signs,
  v = vars,
  x = xvals,
  y = yvals
}

% The global ID number of the env.
\int_new:N  \g_tns_functab_ID_int
\int_set:Nn \g_tns_functab_ID_int { 0 }

% Temporary internal ID.
\tl_new:N \l__tns_functab_tmp_ID_tl

% Relative, and not global, line number of the context (comments and
% empty lines are ignored).
\int_new:N \l__tns_functab_context_line_int


%%%
% prototype::
%     :see: l3func.tns_functab_functable:nn
%%%
\NewDocumentEnvironment{ functable }{ O{} b }{%
  \tns_functab_functable:nn { #1 } { #2 }
}{}


%%%
% prototype::
%     #1 : the user's options.
%     #2 : the DSL code of the table.
%
%     :action: the actions requested by the user are carried out:
%              storage of a new table, possibly with its formatting.
%
%     :see: l3func.tns_functab_core_DSL_ctxt_parser:NnN ,
%           l3func.tns_functab_core_DSL_ctxt_free_memory:N
%
% ----
% TODO : options of functable via key-val
% ----
%%%
\cs_new:Npn \tns_functab_functable:nn #1#2 {
% TODO : Options to use.

% Internal ID nb. that is global to the TeX file compiled.
  \int_gincr:N \g_tns_functab_ID_int

% Parsing the agnostic "context" DSL code.
  \tl_set:Nn \l__tns_functab_tmp_ID_tl {
    -:-
      functable.pre.parsing.contexts.
      \int_use:N \g_tns_functab_ID_int
    -:-
  }

  \tns_functab_core_DSL_ctxt_parser:NnN
    { \l__tns_functab_tmp_ID_tl }
    { #2 }
    { \c_tns_functab_shortname_ctxts_prop }

% -------------
% DEBUG - START

  %  \seq_show:c { \tl_use:N \l__tns_functab_tmp_ID_tl :: contexts }
  %  \seq_show:c { \tl_use:N \l__tns_functab_tmp_ID_tl :: labels   }
  %  \seq_show:c { \tl_use:N \l__tns_functab_tmp_ID_tl :: values   }

% DEBUG - END
% -----------

% Do we have a legal DSL code?
  \tns_functab_validate_ctxts_seq:n
    { \tl_use:N \l__tns_functab_tmp_ID_tl }

% TODO : The options to use (some options are specific to some kind of table).

% Let's do what the user wants.
  \use:c {
    tns_functab_build_internal_
    \use:c { \tl_use:N \l__tns_functab_tmp_ID_tl :: kind }
    :nn
  } {
    \tl_use:N \l__tns_functab_tmp_ID_tl
  } {
    \int_use:N \g_tns_functab_ID_int
  }

% We clear our temporary sequences.
  \tns_functab_core_DSL_ctxt_free_memory:N { \l__tns_functab_tmp_ID_tl }

% -------------
% DEBUG - START

  %  \seq_show:c { \tl_use:N \l__tns_functab_tmp_ID_tl :: contexts }
  %  \seq_show:c { \tl_use:N \l__tns_functab_tmp_ID_tl :: labels }
  %  \seq_show:c { \tl_use:N \l__tns_functab_tmp_ID_tl :: values }

% DEBUG - END
% -----------

}


% :: VALIDATE DATA :: %

% Which contexts have been used?
\bool_new:N \l__tns_functab_xvals_used_bool
\bool_new:N \l__tns_functab_yvals_used_bool
\bool_new:N \l__tns_functab_imgs_used_bool
\bool_new:N \l__tns_functab_mat_used_bool
\bool_new:N \l__tns_functab_signs_vars_used_bool


%%%
% prototype::
%     #1 : the internal ''<ID>'' of the \env.
%
%     :action: ???
%%%
\cs_new:Npn \tns_functab_validate_ctxts_seq:n #1 {
% Good use of the contexts?
%
% NOTE. We have the long name of contexts.
  \int_zero:N \l__tns_functab_context_line_int

  \bool_set_false:N \l__tns_functab_xvals_used_bool
  \bool_set_false:N \l__tns_functab_yvals_used_bool
  \bool_set_false:N \l__tns_functab_imgs_used_bool
  \bool_set_false:N \l__tns_functab_mat_used_bool
  \bool_set_false:N \l__tns_functab_signs_vars_used_bool

  \seq_map_inline:cn { #1 :: contexts } {
    \int_incr:N \l__tns_functab_context_line_int

    \par

    \str_case_e:nnF { ##1 } {
% XVALS.
%
% 1st context and x-dimension.
      { xvals } {
        \int_compare:nNnF \l__tns_functab_context_line_int = 1 {
          \msg_error:nnnn { tns-functab ~ (main) }
            { main : context-misplaced }
            { xvals }
            { 1st }
        }

        \bool_set_true:N \l__tns_functab_xvals_used_bool
      }

% YVALS.
%
% 2nd context if it is used and y-dimension.
      { yvals } {
        \int_compare:nNnF \l__tns_functab_context_line_int = 2 {
          \msg_error:nnnn { tns-functab ~ (main) }
            { main : context-misplaced }
            { yvals }
            { 2nd }
        }

        \bool_set_true:N \l__tns_functab_yvals_used_bool
      }

% IMGS - 1D-DATA.
      { imgs } {
        \bool_if:nT {
               ! \l__tns_functab_xvals_used_bool
            || \l__tns_functab_yvals_used_bool
            || \l__tns_functab_mat_used_bool
            || \l__tns_functab_signs_vars_used_bool
        } {
          \msg_error:nnVn { tns-functab ~ (main) }
            { main : context-bad-use }
            \l__tns_functab_context_line_int
            { ##1 }
        }

        \bool_set_true:N \l__tns_functab_imgs_used_bool
        \tl_gset:cn { #1 :: kind } { ##1 }
      }

% MAT - 2D-DATA.
      { mat } {
        \bool_if:nT {
               ! \l__tns_functab_xvals_used_bool
            || ! \l__tns_functab_yvals_used_bool
            || \l__tns_functab_imgs_used_bool
            || \l__tns_functab_signs_vars_used_bool
        } {
          \msg_error:nnVn { tns-functab ~ (main) }
            { main : context-bad-use }
            \l__tns_functab_context_line_int
            { ##1 }
        }

        \bool_set_true:N \l__tns_functab_mat_used_bool
        \tl_gset:cn { #1 :: kind } { ##1 }
      }

% SIGNS (with or without vars).
      { signs } {
        \bool_if:nT {
               ! \l__tns_functab_xvals_used_bool
            || \l__tns_functab_yvals_used_bool
            || \l__tns_functab_imgs_used_bool
            || \l__tns_functab_mat_used_bool
        } {
          \msg_error:nnVn { tns-functab ~ (main) }
            { main : context-bad-use }
            \l__tns_functab_context_line_int
            { ##1 }
        }

        \bool_set_true:N \l__tns_functab_signs_vars_used_bool
        \tl_gset:cn { #1 :: kind } { ##1_vars }
      }

% VARS (with or without signs).
      { vars } {
        \bool_if:nT {
               ! \l__tns_functab_xvals_used_bool
            || \l__tns_functab_yvals_used_bool
            || \l__tns_functab_imgs_used_bool
            || \l__tns_functab_mat_used_bool
        } {
          \msg_error:nnVn { tns-functab ~ (main) }
            { main : context-bad-use }
            \l__tns_functab_context_line_int
            { ##1 }
        }

        \bool_set_true:N \l__tns_functab_signs_vars_used_bool
        \tl_gset:cn { #1 :: kind } { signs_##1 }
      }

% Let's be silent with the missing context error that have been already
% indicated by the context DSL parser.
      { :-: ctxt-dsl-missing-context :-: } { }

% UNKNOWN CONTEXT
    }{
      \msg_error:nnVn { tns-functab ~ (main) }
        { main : context-unknown  }
        { \int_use:N \l__tns_functab_context_line_int }
        { ##1 }
    }
  }
}






